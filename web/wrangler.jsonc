{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codex-usage-bar",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-27",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "codex.cmmuu.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
